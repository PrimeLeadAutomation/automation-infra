          "rawSQL": "WITH tot AS (SELECT CAST(COUNT(*) AS DOUBLE) AS n FROM final_output WHERE 1=1 \n  AND ('${filtro_uf}' = 'Todos' OR COALESCE(NULLIF(TRIM(uf), ''), '(sem UF)') = '${filtro_uf}')\n  AND ('${filtro_status}' = 'Todos' OR COALESCE(NULLIF(TRIM(status), ''), '(sem status)') = '${filtro_status}')\n  AND ('${filtro_porte}' = 'Todos' OR COALESCE(NULLIF(TRIM(porte), ''), '(sem porte)') = '${filtro_porte}')\n)\nSELECT COALESCE(NULLIF(TRIM(uf), ''), '(sem UF)') AS uf,\n  CAST(COUNT(*) AS BIGINT) AS empresas,\n  100.0 * CAST(COUNT(*) AS DOUBLE) / NULLIF((SELECT n FROM tot), 0) AS pct_do_total\nFROM final_output WHERE 1=1 \n  AND ('${filtro_uf}' = 'Todos' OR COALESCE(NULLIF(TRIM(uf), ''), '(sem UF)') = '${filtro_uf}')\n  AND ('${filtro_status}' = 'Todos' OR COALESCE(NULLIF(TRIM(status), ''), '(sem status)') = '${filtro_status}')\n  AND ('${filtro_porte}' = 'Todos' OR COALESCE(NULLIF(TRIM(porte), ''), '(sem porte)') = '${filtro_porte}')\n\nGROUP BY 1 ORDER BY empresas DESC LIMIT 27"
