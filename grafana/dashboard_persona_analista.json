      "targets": [
        {
          "datasource": {
            "type": "grafana-athena-datasource",
            "uid": "${DS_ATHENA}"
          },
          "connectionArgs": {
            "catalog": "__default",
            "database": "${ATHENA_DB}",
            "region": "__default"
          },
          "format": 1,
          "refId": "A",
          "rawSQL": "WITH raw AS (\n  SELECT status, cnae_fiscal, COALESCE(\n      TRY_CAST(TRIM(CAST(data_inicio_atividade AS VARCHAR)) AS DATE),\n      try(date_parse(nullif(TRIM(CAST(data_inicio_atividade AS VARCHAR)), ''), '%Y-%m-%d')),\n      try(date_parse(nullif(TRIM(CAST(data_inicio_atividade AS VARCHAR)), ''), '%d/%m/%Y'))\n    ) AS di\n  FROM final_output WHERE 1=1 \n  AND ('${filtro_uf}' = 'Todos' OR COALESCE(NULLIF(TRIM(uf), ''), '(sem UF)') = '${filtro_uf}')\n  AND ('${filtro_status}' = 'Todos' OR COALESCE(NULLIF(TRIM(status), ''), '(sem status)') = '${filtro_status}')\n  AND ('${filtro_porte}' = 'Todos' OR COALESCE(NULLIF(TRIM(porte), ''), '(sem porte)') = '${filtro_porte}')\n\n),\nbase AS (\n  SELECT substr(regexp_replace(CAST(cnae_fiscal AS VARCHAR), '[^0-9]', ''), 1, 7) AS cnae,\n         CASE WHEN di <= current_date - INTERVAL '5' YEAR THEN 1 ELSE 0 END AS madura\n  FROM raw\n  WHERE UPPER(TRIM(status)) = 'ATIVA' AND cnae_fiscal IS NOT NULL\n)\nSELECT cnae, CAST(COUNT(*) AS BIGINT) AS volume,\n       100.0 * CAST(SUM(madura) AS DOUBLE) / NULLIF(COUNT(*), 0) AS pct_maduras\nFROM base WHERE LENGTH(cnae) >= 4\nGROUP BY cnae ORDER BY volume DESC LIMIT 12"
        }
      ],
      "title": "Top CNAE: volume + % maduras (≥5 anos)",
      "type": "barchart"
    },
